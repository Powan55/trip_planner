  {
    "name": "trip doc create (createTripDoc)",
    "as": "creator",
    "writes": [
      {
        "op": "set",
        "path": "trips/$NEW_TRIP",
        "data": {
          "schemaVersion": 1,
          "createdAt": {
            "$sentinel": "serverTimestamp"
          },
          "seededFrom": "create",
          "members": {
            "$UID": "owner"
          }
        }
      }
    ]
  },
  {
    "name": "invites/{token} mint (createInvite)",
    "as": "owner",
    "writes": [
      {
        "op": "set",
        "path": "trips/$TRIP/invites/$INVITE",
        "data": {
          "createdBy": "$UID",
          "createdAt": {
            "$sentinel": "serverTimestamp"
          }
        }
      }
    ]
  },
  {
    "name": "invite redeem batch (redeemInvite)",
    "as": "joiner",
    "writes": [
      {
        "op": "batch",
        "path": "",
        "writes": [
          {
            "op": "update",
            "path": "trips/$TRIP/invites/$INVITE",
            "data": {
              "redeemedBy": "$UID",
              "redeemedAt": {
                "$sentinel": "serverTimestamp"
              }
            }
          },
          {
            "op": "update",
            "path": "trips/$TRIP",
            "data": {
              "members.$UID": "member",
              "joinInvite": "$INVITE"
            }
          }
        ]
      }
    ]
  },
