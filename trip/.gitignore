# Playwright artifacts. Generated by test runs, not source.
test-results/
playwright-report/
blob-report/
.playwright/
e2e/.cache/
e2e/.auth/

# A real captured browser profile from the owner's own device: live flight,
# hotel and traveller details. It stays on the machine that captured it and
# never enters this repo.
#
# e2e/live-vault-acceptance.spec.ts skips itself when this file is absent, so
# CI stays green without it. Do not "fix" that skip by generating a synthetic
# replacement. The point of this fixture is that it holds bytes a hand-written
# one never would, so a synthetic stand-in would make the spec pass while
# proving nothing.
e2e/fixtures/live-v5-vault/live-dump.json

# Local build-time config (Firebase keys, concierge URL). See .env.local.example.
.env.local
