{
  "name": "app",
  "private": true,
  "version": "7.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/flatten-segment-payloads.mjs && node scripts/gen-sw.mjs",
    "build:e2e": "node -e \"process.env.NEXT_PUBLIC_CONCIERGE_URL='https://concierge.test';require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "analyze": "next build --webpack && node scripts/flatten-segment-payloads.mjs && node scripts/gen-sw.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "gen:images": "node scripts/gen-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run lib/__tests__/content-validation.test.ts",
    "test:e2e": "playwright test",
    "contrast-check": "node scripts/contrast-tokens.mjs",
    "loop-check": "node scripts/motion-loops.mjs",
    "marker-check": "node scripts/marker-check.mjs",
    "token-check": "node scripts/token-wrappers.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "16.3.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "20.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "10.5.4",
    "eslint": "9.24.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "^29.1.1",
    "postcss": "8.5.26",
    "sharp": "^0.35.2",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "firebase": "^12.18.0",
    "framer-motion": "12.42.2",
    "lucide-react": "0.446.0",
    "maplibre-gl": "5.24.0",
    "next": "16.3.2",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "2.5.2",
    "zod": "4.5.2"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "Firefox ESR",
    "not dead"
  ]
}
