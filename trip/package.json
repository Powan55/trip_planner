{
  "name": "app",
  "private": true,
  "version": "7.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build --webpack && node scripts/flatten-segment-payloads.mjs && node scripts/gen-sw.mjs",
    "build:e2e": "node -e \"process.env.NEXT_PUBLIC_CONCIERGE_URL='https://concierge.test';require('child_process').execSync('npm run build',{stdio:'inherit'})\"",
    "analyze": "node scripts/copy-maplibre-worker.mjs && next build --webpack && node scripts/flatten-segment-payloads.mjs && node scripts/gen-sw.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "gen:images": "node scripts/gen-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run lib/__tests__/content-validation.test.ts",
    "test:e2e": "playwright test",
    "contrast-check": "node scripts/contrast-tokens.mjs",
    "loop-check": "node scripts/motion-loops.mjs",
    "marker-check": "node scripts/marker-check.mjs",
    "token-check": "node scripts/token-wrappers.mjs",
    "budget-check": "node scripts/asset-budget.mjs",
    "precache-budget": "node scripts/precache-budget.mjs",
    "credits-check": "node scripts/credits-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.0.1",
    "postcss": "8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "firebase": "^12.19.0",
    "framer-motion": "12.42.2",
    "lucide-react": "0.446.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zod": "3.23.8"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions",
    "Firefox ESR",
    "not dead"
  ]
}
